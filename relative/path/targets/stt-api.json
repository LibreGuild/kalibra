      "query": [],
      "scripts": {
        "afterResponse": "",
        "beforeRequest": ""
      },
      "streaming": {
        "doneWhen": "",
        "mode": "none",
        "textPath": ""
      },
      "timeoutMs": 60000,
      "url": "{{vars.base_url}}/stt"
    },
    "variables": [
      {
        "enabled": true,
        "key": "base_url",
        "value": "http://localhost:9"
      }
    ]
  }
