{
  "description": "",
  "name": "STT API",
  "spec": {
    "config": {
      "auth": {
        "type": "none"
      },
      "body": {
        "binary": "",
        "content": "",
        "contentType": "",
        "form": [],
        "parts": [],
        "type": "none"
      },
      "followRedirects": true,
      "headers": [
        {
          "enabled": true,
          "key": "Authorization",
          "value": "Bearer {{secret.api_token}}"
        }
      ],
      "kind": "http",
