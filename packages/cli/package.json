{
  "name": "kalibra",
  "version": "0.2.1",
  "description": "Local-first, open-source evaluation for AI applications: datasets, HTTP/WebSocket targets, layered checks (WER, LLM judge, …), runs and comparisons. Run with `npx kalibra`.",
  "license": "MIT",
  "author": "LibreGuild",
  "homepage": "https://github.com/LibreGuild/kalibra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LibreGuild/kalibra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/LibreGuild/kalibra/issues"
  },
  "type": "module",
  "bin": {
    "kalibra": "dist/kalibra.mjs"
  },
  "files": [
    "dist/kalibra.mjs",
    "dist/chunks",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "llm",
    "evals",
    "evaluation",
    "ai",
    "testing",
    "speech-to-text",
    "wer",
    "llm-as-judge",
    "mcp"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "@kalibra/core": "0.2.1",
    "@kalibra/server": "0.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
