# Copy to .env next to docker-compose.yml. Every variable is optional.
# Full list: docs/users-and-projects.md and docs/deploy.md

# First administrator (otherwise use the one-time link from `docker compose logs kalibra`)
# KALIBRA_ADMIN_USERNAME=admin
# KALIBRA_ADMIN_PASSWORD=

# Sign in with Google (callback: https://<your host>/api/auth/sso/google/callback)
# KALIBRA_GOOGLE_CLIENT_ID=
# KALIBRA_GOOGLE_CLIENT_SECRET=
# KALIBRA_GOOGLE_DOMAINS=example.com

# Sign in with GitHub or GitHub Enterprise (callback: https://<your host>/api/auth/sso/github/callback)
# KALIBRA_GITHUB_URL=https://github.com
# KALIBRA_GITHUB_CLIENT_ID=
# KALIBRA_GITHUB_CLIENT_SECRET=
# KALIBRA_GITHUB_ORGS=your-org

# Any OpenID Connect provider (company SSO, Okta, Keycloak, Entra…) (callback: …/api/auth/sso/sso/callback)
# KALIBRA_OIDC_ISSUER=
# KALIBRA_OIDC_CLIENT_ID=
# KALIBRA_OIDC_CLIENT_SECRET=
# KALIBRA_OIDC_NAME=Company sign-in
